# Dependencies
node_modules

# Build output
dist
build

# Environment files — secrets never get committed; .env.example files stay tracked
.env
.env.local
.env.*.local
.env.*
!.env.example

# Logs & OS files
*.log
.DS_Store

# Local image-processing runtimes and model weights (installed by scripts/setup-ml.sh)
backend/vendor/
backend/python/.venv/
backend/python/.venv-ocr/
backend/python/.venv-inpaint/
backend/python/.models/
__pycache__/
*.pyc
*.onnx

# Local scratch files (tests, snapshots)
.tmp-*

# graphify knowledge-graph output (local only)
graphify-out/

# Third-party PDFs the docx QA downloads (not redistributed)
backend/python/tests/docx_fixtures/.cache/
backend/python/tests/docx_fixtures/out/
