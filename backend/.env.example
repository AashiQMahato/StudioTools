PORT=5000
FRONTEND_URL=http://localhost:5173
# Proxies in front of the API (a tunnel, a host's load balancer), so rate limits see each visitor's address.
TRUST_PROXY=

# ---------------------------------------------------------------- Uploads
MAX_IMAGE_SIZE_MB=10
# Largest decoded image (pixels) — protects against decompression bombs.
MAX_IMAGE_PIXELS=40000000
# Image-processing requests per client per 15 minutes, and how many may wait for a free slot.
PROCESSING_RATE_LIMIT=60
PROCESSING_MAX_QUEUE=8

# ---------------------------------------------------------------- Background removal (BiRefNet-Massive)
# The only model: BiRefNet-Massive (MIT), downloaded once by scripts/setup-ml.sh. off = run without it (small servers).
BACKGROUND_REMOVAL=on
# auto = CUDA, then Apple MPS, then CPU.
BIREFNET_DEVICE=auto
# Leave empty to use backend/python/.models/birefnet-massive.
BIREFNET_MODEL_PATH=
# Quality mode's input size (longest side). Empty = automatic: 768 on 8 GB Apple Silicon, 1024 with more memory or CUDA, 512 on CPU.
BIREFNET_INPUT_SIZE=
# fp16 on a GPU (half the memory, same masks), fp32 on the CPU. Empty = automatic.
BIREFNET_PRECISION=
# Edge refinement: alpha between these is the uncertain band that gets refined; outside it is left alone.
EDGE_LOW_THRESHOLD=0.05
EDGE_HIGH_THRESHOLD=0.95
# Guided-filter regularisation (smaller follows the photo's edges more closely) and the refinement size cap.
REFINE_EPS=0.0001
REFINE_MAX_SIDE=2048
# Halo removal in the soft edge band, 0–1 (0 = off).
DECONTAMINATE_STRENGTH=1
# Ultra (1024 px): auto = on a GPU (stable on an 8 GB M2), off on the CPU.
BIREFNET_ULTRA=auto
BACKGROUND_REMOVAL_TIMEOUT_MS=120000
BACKGROUND_REMOVAL_CONCURRENCY=1

# The API starts the Python image service itself (localhost, random port, per-launch token).
# To run it separately instead, set IMAGE_SERVICE_AUTOSTART=false and IMAGE_SERVICE_URL / IMAGE_SERVICE_TOKEN.
IMAGE_SERVICE_AUTOSTART=true
IMAGE_SERVICE_URL=
IMAGE_SERVICE_TOKEN=

# ---------------------------------------------------------------- Upscaling (Upscayl / upscayl-ncnn)
# Leave paths empty to use backend/vendor/upscayl (installed by scripts/setup-ml.sh).
UPSCAYL_ENABLED=true
UPSCAYL_BINARY_PATH=
UPSCAYL_MODELS_PATH=
# One of the installed models: upscayl-standard-4x (default), upscayl-lite-4x (much faster), digital-art-4x.
UPSCAYL_MODEL=upscayl-standard-4x
UPSCALE_TIMEOUT_MS=300000
UPSCALE_CONCURRENCY=1
# Largest upscaled result, in pixels (4× accepts smaller inputs than 2×).
UPSCALE_MAX_OUTPUT_PIXELS=40000000

# ---------------------------------------------------------------- Retouch
# auto   — for Remove object / Repair: the IOPaint service below if configured, else LaMa (INPAINT_MODEL) if installed, else built-in.
# lama   — always LaMa in the local image service.
# local  — always use the built-in engine (no extra setup; classical image processing).
# iopaint — require the AI service for Remove object / Repair (Smooth, Enhance and Relight always run built-in).
RETOUCH_PROVIDER=auto
# An IOPaint server running the LaMa model, e.g. `iopaint start --model=lama --port=8080`.
RETOUCH_SERVICE_URL=
RETOUCH_TIMEOUT_MS=120000
RETOUCH_CONCURRENCY=2
# Longest side (px) of the selected region sent for processing; the result is blended back at full resolution.
RETOUCH_MAX_WORKING_SIZE=2048

# ---------------------------------------------------------------- Inpainting & watermark remover
# LaMa inpainting model (ONNX, ~200 MB, Apache-2.0), downloaded by scripts/setup-ml.sh. Leave empty for the default path.
INPAINT_MODEL=
# PP-OCRv3 text detector used to find text watermarks. Leave empty for the default path.
TEXT_DETECTOR_MODEL=
WATERMARK_DETECTION_PROVIDER=opencv
# auto (IOPaint if configured → LaMa if installed → built-in), local, lama or iopaint.
WATERMARK_REMOVAL_PROVIDER=auto
WATERMARK_TIMEOUT_MS=60000
# Parallel compression jobs.
COMPRESSION_CONCURRENCY=2

# ---------------------------------------------------------------- Passport & MRP photo generator
# Face detection uses OpenCV's YuNet model (downloaded by scripts/setup-ml.sh). Leave empty for the default path.
FACE_DETECTOR_MODEL=
# Output resolution for each preset (the physical size, 35 × 45 mm, is fixed by the preset).
PHOTO_PASSPORT_DPI=300
PHOTO_MRP_DPI=600
PHOTO_GENERATOR_CONCURRENCY=2
# Generated photos are kept in memory (never on disk) for this long, then deleted.
PHOTO_FILE_TTL_MINUTES=30
PHOTO_GENERATOR_TIMEOUT_MS=60000

# ---------------------------------------------------------------- OCR editor
# auto      — PaddleOCR (installed by scripts/setup-ml.sh), else Tesseract if it's on this machine.
# paddle    — PaddleOCR only.   tesseract — Tesseract only (no layout model; needs the eng and nep languages).
OCR_PROVIDER=auto
# PaddleOCR's own Python environment and model cache. Leave empty for the defaults under backend/python/.
OCR_PYTHON_PATH=
OCR_MODELS_DIR=
# Model choices (defaults measured to be the best speed/accuracy trade-off on CPU).
OCR_DETECTION_MODEL=PP-OCRv5_mobile_det
OCR_ENGLISH_MODEL=PP-OCRv6_medium_rec
OCR_DEVANAGARI_MODEL=devanagari_PP-OCRv5_mobile_rec
OCR_LAYOUT_MODEL=PP-DocLayout_plus-L
OCR_ORIENTATION_MODEL=PP-LCNet_x1_0_doc_ori
TESSERACT_PATH=tesseract
OCR_TIMEOUT_MS=180000
OCR_CONCURRENCY=1

# ---------------------------------------------------------------- Document tools (PDF)
# Uploads and results live in a private temp folder (never served), deleted when a job expires, fails
# or is cancelled — and the whole folder is wiped when the API starts. Leave empty for the system temp dir.
DOCUMENTS_TEMP_DIR=
DOCUMENTS_MAX_PDF_MB=100
DOCUMENTS_MAX_IMAGE_MB=25
DOCUMENTS_MAX_TOTAL_MB=250
DOCUMENTS_MAX_FILES=50
DOCUMENTS_MAX_PAGES=2000
# Finished results can be downloaded for this long, then they're deleted.
DOCUMENTS_RESULT_TTL_MINUTES=30
DOCUMENTS_CONCURRENCY=2
DOCUMENTS_MAX_RENDER_PIXELS=60000000
