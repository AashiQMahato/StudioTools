# Optional. Base URL of the backend API for production builds (e.g. https://api.example.com).
# Leave empty in development: Vite proxies /api to the backend.
# Never put provider API keys here — every VITE_* variable is bundled into the browser.
VITE_API_BASE_URL=

# Optional. A separate server for the AI tools — background removal, passport photos and upscaling —
# e.g. a Mac reached through a tunnel (scripts/ai-server.sh). Empty: they use VITE_API_BASE_URL.
VITE_AI_API_BASE_URL=

# Optional, dev server only (not bundled). Where Vite proxies /api. Defaults to http://localhost:5000.
API_PROXY_TARGET=
